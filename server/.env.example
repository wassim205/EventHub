# Connexion PostgreSQL (docker compose -> service db)
DATABASE_URL="postgresql://eventhub:eventhub@localhost:5432/eventhub?schema=public"

# Serveur
NODE_ENV="development"
PORT=4000

# Secrets de signature des JWT. À remplacer impérativement en production.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
ACCESS_TOKEN_TTL="30m"
REFRESH_TOKEN_TTL_DAYS=7

# Nom du cookie qui porte le refresh token (HttpOnly)
REFRESH_COOKIE_NAME="eventhub_refresh"